# Copy to .env and adjust if needed:  cp .env.example .env
# Used by both docker-compose.yml and the backend settings.

POSTGRES_USER=papertrail
POSTGRES_PASSWORD=papertrail
POSTGRES_DB=papertrail
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend
LOG_LEVEL=INFO

# Question answering (/ask). "none" disables answer generation (search still works).
# For a free local model: install Ollama, run `ollama pull qwen2.5:7b`, then set LLM_PROVIDER=ollama.
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Minimum cosine similarity for a passage to count as evidence (a heuristic; see docs/MANUAL_EVALUATION.md).
RAG_MIN_SCORE=0.70
