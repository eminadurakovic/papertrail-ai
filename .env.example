# Copy to .env: cp .env.example .env

POSTGRES_USER=papertrail
POSTGRES_PASSWORD=papertrail
POSTGRES_DB=papertrail
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend
LOG_LEVEL=INFO

# LLM for /ask: none or ollama (needs `ollama pull qwen2.5:7b`).
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Minimum cosine similarity for a passage to count as evidence (a heuristic; see docs/MANUAL_EVALUATION.md).
RAG_MIN_SCORE=0.70
